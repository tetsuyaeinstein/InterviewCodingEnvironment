# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY. These credentials protect a disposable Docker
# database on your own machine that contains only fictitious data.
# Never reuse them anywhere else. Copy this file to .env (gitignored).
# ---------------------------------------------------------------------------
LAB_DB_HOST=localhost
LAB_DB_PORT=5433
LAB_DB_NAME=interview_lab

# Superuser created by the postgres container; used only by `lab db migrate/seed/reset`.
LAB_ADMIN_USER=lab_admin
LAB_ADMIN_PASSWORD=lab_admin_local_only

# Grader role: read-only on shared tables, may create disposable lab_sb_* sandbox schemas.
LAB_GRADER_USER=lab_grader
LAB_GRADER_PASSWORD=lab_grader_local_only

# Practice role: SELECT-only, read-only sessions. Use this one in SQLTools / psql.
LAB_PRACTICE_USER=lab_practice
LAB_PRACTICE_PASSWORD=lab_practice_local_only

# Query safety limits for `lab run` / `lab check`.
LAB_STATEMENT_TIMEOUT_MS=15000
LAB_MAX_DISPLAY_ROWS=50
