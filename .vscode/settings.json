{
  // Windows path. On macOS/Linux use "${workspaceFolder}/.venv/bin/python" (the Python
  // extension also auto-detects .venv, so this line is just a default).
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["python/tests"],

  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "[markdown]": { "files.trimTrailingWhitespace": false },
  "[sql]": { "editor.tabSize": 4, "editor.insertSpaces": true },

  // Spoiler protection: keep reference answers out of search and Quick Open (Ctrl+P).
  // Open them deliberately with `python -m lab solution <ID>` or the Explorer.
  "search.exclude": {
    "**/sql/solutions/**": true,
    "**/sql/explanations/**": true,
    "**/sql/checks/**": true,
    "**/python/solutions/**": true,
    "**/python/explanations/**": true,
    "**/sql/hints/**": true,
    "**/python/hints/**": true,
    "**/.lab_tmp/**": true
  },

  // SQLTools connection to the LOCAL lab database as the read-only practice role.
  // Credentials are local-development-only (see .env.example).
  "sqltools.connections": [
    {
      "name": "Interview Lab (practice, read-only)",
      "driver": "PostgreSQL",
      "server": "localhost",
      "port": 5433,
      "database": "interview_lab",
      "username": "lab_practice",
      "password": "lab_practice_local_only",
      "previewLimit": 50,
      "connectionTimeout": 10
    }
  ],
  "sqltools.highlightQuery": true,
  "sqltools.results.limit": 200
}
